# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=NetManage
LOG_LEVEL=info
APP_KEY=  # run: node ace generate:key
APP_URL=http://${HOST}:${PORT}

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=netmanage
DB_PASSWORD=netmanage
DB_DATABASE=netmanage

# Session
SESSION_DRIVER=cookie

# Mail
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=no-reply@netmanage.local
MAIL_FROM_NAME=NetManage
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
